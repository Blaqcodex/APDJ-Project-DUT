<Window x:Class="CampusPulse.Admin.LecturerChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse - Change Lecturer Password"
        Height="540"
        Width="470"
        MinHeight="500"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="24"
                Padding="28"
                Background="White"
                CornerRadius="16">

            <StackPanel>

                <TextBlock Text="Secure Your Account"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#172B4D"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Before accessing CampusPulse, you must replace your temporary lecturer password."
                           TextWrapping="Wrap"
                           Foreground="#52647A"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Current password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="CurrentPasswordInput"
                             Height="38"
                             Padding="10,7"
                             Margin="0,0,0,18"/>

                <TextBlock Text="New password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="NewPasswordInput"
                             Height="38"
                             Padding="10,7"
                             Margin="0,0,0,7"/>

                <TextBlock Text="Use at least 8 characters and a password different from your temporary password."
                           Foreground="#52647A"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Confirm new password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="38"
                             Padding="10,7"
                             Margin="0,0,0,18"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button x:Name="ChangePasswordButton"
                        Content="Change Password"
                        Height="44"
                        Background="#1769AA"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="ChangePassword_Click"/>

                <TextBlock Text="You cannot access the lecturer dashboard until your password has been changed."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#52647A"
                           FontSize="12"
                           Margin="0,18,0,0"/>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>