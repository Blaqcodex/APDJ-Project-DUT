<Window x:Class="CampusPulse.Admin.PortalSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Select Portal"
        Width="920"
        Height="600"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#142849">
            <StackPanel VerticalAlignment="Center" Margin="45">
                <TextBlock Text="CampusPulse"
                           Foreground="White"
                           FontSize="35"
                           FontWeight="Bold"/>

                <TextBlock Text="DUT CAMPUS MANAGEMENT"
                           Foreground="#A9C3E9"
                           FontSize="13"
                           Margin="2,12,0,0"/>

                <Border Background="#29456D"
                        Height="1"
                        Margin="0,35,0,35"/>

                <TextBlock Text="One campus. Connected."
                           Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Manage teaching, attendance and campus communication from one connected platform."
                           Foreground="#BED0E9"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="40"
                    Margin="35"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Welcome to CampusPulse"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Select your portal to continue."
                               Foreground="#718096"
                               FontSize="14"
                               Margin="0,10,0,30"/>

                    <Button x:Name="LecturerButton"
                            Content="Lecturer Portal"
                            Height="52"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Lecturer_Click"/>

                    <Button x:Name="AdminButton"
                            Content="Administrator Portal"
                            Height="52"
                            Margin="0,16,0,0"
                            Background="#142849"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Admin_Click"/>

                    <TextBlock Text="Student access is available through the CampusPulse Android app."
                               Foreground="#718096"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>