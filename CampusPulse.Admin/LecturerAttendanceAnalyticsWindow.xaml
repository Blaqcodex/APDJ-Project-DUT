<Window x:Class="CampusPulse.Admin.LecturerAttendanceAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Attendance Analytics"
        Height="720"
        Width="1100"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Attendance Analytics"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Review recorded attendance for your assigned module."
                       Margin="0,7,0,0"
                       FontSize="14"
                       Foreground="#5C6B80"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="MODULE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#64748B"/>

                <TextBlock x:Name="ModuleTitleText"
                           Text="Loading module..."
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,6,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="Refresh Analytics"
                            Click="Refresh_Click"/>

                    <Button x:Name="ExportExcelButton"
                            Content="Export to Excel"
                            Click="ExportExcel_Click"
                            IsEnabled="False"
                            Background="#0F766E"
                            Foreground="White"
                            BorderThickness="0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0,0,0,16">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Enrolled Students"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="StudentsCountText"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Completed Sessions"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="SessionsCountText"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Attendance"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="AttendancePercentageText"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Present Marks"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="PresentMarksText"
                               Text="—"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="16">

            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,14">
                    <TextBlock Text="Student Attendance"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Percentages use current module enrollment and completed sessions. No check-in recorded means there is no Present mark for a completed session; it does not confirm physical absence."
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               Foreground="#64748B"/>
                </StackPanel>

                <DataGrid x:Name="StudentsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#F8FAFC">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Student Number"
                                            Binding="{Binding StudentNumber}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Student"
                                            Binding="{Binding FullName}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="Present"
                                            Binding="{Binding Present}"
                                            Width="0.7*"/>

                        <DataGridTextColumn Header="No Check-in"
                                            Binding="{Binding Absent}"
                                            Width="0.7*"/>

                        <DataGridTextColumn Header="Attendance"
                                            Binding="{Binding PercentageDisplay}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Follow-up"
                                            Binding="{Binding SupportStatus}"
                                            Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="FooterText"
                   Margin="0,15,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Text="No check-in recorded is not a verified absence. Review records before contacting students."/>
    </Grid>
</Window>