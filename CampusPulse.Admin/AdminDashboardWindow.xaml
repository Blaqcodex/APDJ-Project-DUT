<Window x:Class="CampusPulse.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Admin Dashboard"
        Width="1100"
        Height="700"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#142849">
            <DockPanel Margin="30,0">
                <Button Content="Sign Out"
                        DockPanel.Dock="Right"
                        Width="105"
                        Height="38"
                        Margin="0,20,0,20"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SignOut_Click"/>

                <TextBlock Text="CampusPulse  /  Administrator"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="40">
            <StackPanel>
                <TextBlock Text="Admin Dashboard"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock x:Name="WelcomeText"
                           FontSize="17"
                           Foreground="#718096"
                           Margin="0,12,0,30"/>

                <Border Background="White"
                        CornerRadius="14"
                        Padding="30">
                    <StackPanel>
                        <TextBlock Text="Administrator access active"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"/>

                        <TextBlock Text="Manage registered CampusPulse accounts and review user roles."
                                   FontSize="15"
                                   Foreground="#718096"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0"/>
                        <Button Content="Open User Management"
                                Width="230"
                                Height="44"
                                HorizontalAlignment="Left"
                                Margin="0,24,0,0"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenUsers_Click"/>
                        <Button Content="Open Module Management"
                                Width="230"
                                Height="44"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Background="#142849"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenModules_Click"/>
                        <Button Content="Open Programme Management"
                                Width="230"
                                Height="44"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Background="#142849"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenProgrammes_Click"/>                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>