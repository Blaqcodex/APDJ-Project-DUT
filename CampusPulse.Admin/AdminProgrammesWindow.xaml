<Window x:Class="CampusPulse.Admin.AdminProgrammesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Programme Management"
        Width="1150"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#142849">
            <DockPanel Margin="30,0">
                <Button Content="Back to Dashboard"
                        DockPanel.Dock="Right"
                        Width="160"
                        Height="38"
                        Margin="0,20,0,20"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="CampusPulse  /  Programme Management"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Academic Programmes"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Review academic programmes and register new programmes."
                           Margin="0,8,0,22"
                           FontSize="15"
                           Foreground="#718096"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Search programmes"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="SearchInput"
                                 Height="35"
                                 Padding="9,5"
                                 TextChanged="SearchInput_TextChanged"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Content="Refresh"
                            Height="35"
                            VerticalAlignment="Bottom"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Refresh_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="15"
                        Margin="0,0,18,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Margin="5,0,5,12"
                                   Foreground="#526581"
                                   FontSize="14"/>

                        <DataGrid x:Name="ProgrammesGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="43"
                                  ColumnHeaderHeight="42"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding ProgrammeId}"
                                                    Width="65"/>
                                <DataGridTextColumn Header="Programme"
                                                    Binding="{Binding ProgrammeName}"
                                                    Width="2*"/>
                                <DataGridTextColumn Header="Faculty"
                                                    Binding="{Binding Faculty}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Add New Programme"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="A programme name must be unique within its faculty."
                                   TextWrapping="Wrap"
                                   Foreground="#718096"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Programme Name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="NameInput"
                                 Height="36"
                                 MaxLength="150"
                                 Padding="9,5"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="Faculty"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="FacultyInput"
                                 Height="36"
                                 MaxLength="150"
                                 Padding="9,5"
                                 Margin="0,0,0,20"/>

                        <Button x:Name="AddButton"
                                Content="Add Programme"
                                Height="42"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AddProgramme_Click"/>

                        <TextBlock x:Name="FormStatusText"
                                   Margin="0,18,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#526581"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>