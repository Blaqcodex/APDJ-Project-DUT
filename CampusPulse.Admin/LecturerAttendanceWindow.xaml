<Window x:Class="CampusPulse.Admin.LecturerAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Live Attendance"
        Width="880"
        Height="730"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38">

            <TextBlock Text="Live Attendance"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Generate a secure QR code for student attendance."
                       Foreground="#718096"
                       FontSize="14"
                       Margin="0,8,0,25"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel>
                    <TextBlock Text="Session Setup"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"/>

                    <Grid Margin="0,18,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Timetable ID"/>
                            <TextBox x:Name="TimetableIdInput"
                                     Text="1"
                                     Height="38"
                                     Margin="0,8,0,0"
                                     Padding="9"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Duration (minutes)"/>
                            <TextBox x:Name="DurationInput"
                                     Text="60"
                                     Height="38"
                                     Margin="0,8,0,0"
                                     Padding="9"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="StartButton"
                            Content="Start Attendance"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Click="Start_Click"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,22,0,0">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Scan to Mark Attendance"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"
                               HorizontalAlignment="Center"/>

                    <Border Background="#F4F7FB"
                            Padding="15"
                            Margin="0,20,0,12">

                        <Image x:Name="QrImage"
                               Width="250"
                               Height="250"
                               Stretch="Uniform"/>
                    </Border>

                    <TextBlock x:Name="QrStatusText"
                               Text="Start a session to generate a QR code."
                               Foreground="#718096"
                               TextAlignment="Center"
                               Margin="0,8,0,8"/>

                    <TextBlock x:Name="SessionStatusText"
                               Foreground="#718096"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button x:Name="RotateButton"
                                Content="Refresh QR"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Margin="0,0,12,0"
                                Click="Rotate_Click"/>

                        <Button x:Name="EndButton"
                                Content="End Attendance"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="16,11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="End_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>