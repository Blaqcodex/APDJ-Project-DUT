<Window x:Class="CampusPulse.Admin.AdminUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | User Management"
        Width="1150"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#142849">
            <DockPanel Margin="30,0">
                <Button Content="Back to Dashboard"
                        DockPanel.Dock="Right"
                        Width="160"
                        Height="38"
                        Margin="0,20,0,20"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="CampusPulse  /  User Management"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Registered Users"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="View registered students, lecturers and administrators."
                           Margin="0,8,0,22"
                           FontSize="15"
                           Foreground="#718096"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,18">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Filter by role"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="RoleFilter"
                                  Height="35"
                                  SelectionChanged="RoleFilter_SelectionChanged">
                            <ComboBoxItem Content="All Users"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="Student"/>
                            <ComboBoxItem Content="Lecturer"/>
                            <ComboBoxItem Content="Admin"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,20,0">
                        <TextBlock Text="Search users"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="SearchInput"
                                 Height="35"
                                 Padding="9,5"
                                 TextChanged="SearchInput_TextChanged"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="RefreshButton"
                            Content="Refresh"
                            Height="35"
                            VerticalAlignment="Bottom"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Refresh_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusText"
                               Margin="5,0,5,12"
                               Foreground="#526581"
                               FontSize="14"/>

                    <DataGrid x:Name="UsersGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="43"
                              ColumnHeaderHeight="42"
                              BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding UserId}"
                                                Width="65"/>

                            <DataGridTextColumn Header="First Name"
                                                Binding="{Binding FirstName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Last Name"
                                                Binding="{Binding LastName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding AccountStatus}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">

                        <Button x:Name="DeactivateButton" Content="Deactivate Selected"
                                Width="165"
                                Height="38"
                                Margin="0,0,12,0"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Deactivate_Click"/>

                        <Button x:Name="ReactivateButton" Content="Reactivate Selected"
                                Width="165"
                                Height="38"
                                Background="#15803D"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Reactivate_Click"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>