<Window x:Class="CampusPulse.Admin.LecturerLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Lecturer Sign In"
        Width="920"
        Height="600"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#142849">
            <StackPanel VerticalAlignment="Center"
                        Margin="45">

                <TextBlock Text="CampusPulse"
                           Foreground="White"
                           FontSize="35"
                           FontWeight="Bold"/>

                <TextBlock Text="LECTURER PORTAL"
                           Foreground="#A9C3E9"
                           FontSize="13"
                           Margin="2,12,0,0"/>

                <Border Background="#29456D"
                        Height="1"
                        Margin="0,35,0,35"/>

                <TextBlock Text="Manage attendance with confidence."
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Sign in to manage your classes and attendance sessions."
                           Foreground="#BED0E9"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="40"
                    Margin="35"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Welcome back"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="#172B4D"/>

                    <TextBlock Text="Sign in to your lecturer account"
                               Foreground="#718096"
                               FontSize="14"
                               Margin="0,10,0,30"/>

                    <TextBlock Text="Email address"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"/>

                    <TextBox x:Name="EmailInput"
                             Height="42"
                             FontSize="15"
                             Padding="10"
                             Margin="0,9,0,20"/>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10"
                                 Margin="0,9,0,25"/>

                    <Button x:Name="SignInButton"
                            Content="Sign In"
                            Height="46"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SignIn_Click"/>

                    <TextBlock x:Name="StatusText"
                               TextWrapping="Wrap"
                               Foreground="#C0392B"
                               FontSize="13"
                               Margin="0,17,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>