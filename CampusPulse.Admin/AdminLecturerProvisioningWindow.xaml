<Window x:Class="CampusPulse.Admin.AdminLecturerProvisioningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Create Lecturer"
        Width="800"
        Height="800"
        MinWidth="650"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#142849">
            <DockPanel Margin="30,0">
                <Button Content="Back to Dashboard"
                        DockPanel.Dock="Right"
                        Width="160"
                        Height="38"
                        Margin="0,20,0,20"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="CampusPulse  /  Lecturer Provisioning"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="35"
                        MaxWidth="680">

                <TextBlock Text="Create Lecturer Account"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Register a lecturer with a temporary password. The lecturer must change it at first login."
                           FontSize="15"
                           Foreground="#718096"
                           TextWrapping="Wrap"
                           Margin="0,10,0,24"/>

                <Border Background="White"
                        CornerRadius="14"
                        Padding="28">

                    <StackPanel>

                        <TextBlock Text="First Name"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="FirstNameInput"
                                 Height="38"
                                 Margin="0,8,0,16"
                                 MaxLength="100"/>

                        <TextBlock Text="Last Name"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="LastNameInput"
                                 Height="38"
                                 Margin="0,8,0,16"
                                 MaxLength="100"/>

                        <TextBlock Text="DUT Email Address"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="EmailInput"
                                 Height="38"
                                 Margin="0,8,0,16"
                                 MaxLength="254"/>

                        <TextBlock Text="Staff Number"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="StaffNumberInput"
                                 Height="38"
                                 Margin="0,8,0,16"
                                 MaxLength="50"/>

                        <TextBlock Text="Department"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="DepartmentInput"
                                 Height="38"
                                 Margin="0,8,0,16"
                                 MaxLength="150"/>

                        <TextBlock Text="Temporary Password (12-128 characters)"
                                   FontWeight="SemiBold"/>
                        <PasswordBox x:Name="TemporaryPasswordInput"
                                     Height="38"
                                     Margin="0,8,0,16"
                                     MaxLength="128"/>

                        <TextBlock Text="Confirm Temporary Password"
                                   FontWeight="SemiBold"/>
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     Height="38"
                                     Margin="0,8,0,20"
                                     MaxLength="128"/>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#526581"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Button x:Name="CreateLecturerButton"
                                Content="Create Lecturer Account"
                                Height="44"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CreateLecturer_Click"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>