<Window x:Class="CampusPulse.Admin.AdminStudentEnrolmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Student Enrolments"
        Width="1200"
        Height="780"
        MinWidth="950"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#142849">
            <DockPanel Margin="30,0">
                <Button Content="Back to Dashboard"
                        DockPanel.Dock="Right"
                        Width="160"
                        Height="38"
                        Margin="0,20,0,20"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="CampusPulse  /  Student Enrolments"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Student Enrolments"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Assign a programme to enrol its modules automatically, then adjust individual module enrolments."
                           Margin="0,8,0,22"
                           FontSize="15"
                           Foreground="#718096"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Select Student"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="StudentSelector"
                                  Height="38"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="StudentSelector_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="Assign Programme"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="ProgrammeSelector"
                                  Height="38"
                                  DisplayMemberPath="DisplayName"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="AssignProgrammeButton"
                            Content="Assign Programme"
                            Height="38"
                            VerticalAlignment="Bottom"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="AssignProgramme_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,18,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Current Module Enrolments"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="1"
                                   Foreground="#526581"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="EnrolledModulesGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="43"
                                  ColumnHeaderHeight="42"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code"
                                                    Binding="{Binding ModuleCode}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Module"
                                                    Binding="{Binding ModuleName}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <Button x:Name="RefreshButton"
                                    Content="Refresh"
                                    Width="115"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="#142849"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="Refresh_Click"/>

                            <Button x:Name="RemoveModuleButton"
                                    Content="Remove Selected"
                                    Width="150"
                                    Height="38"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="RemoveModule_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Add Module"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Select a module from the student's assigned programme."
                                   TextWrapping="Wrap"
                                   Foreground="#718096"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="Available Module"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="AvailableModuleSelector"
                                  Height="38"
                                  DisplayMemberPath="ModuleCode"
                                  Margin="0,0,0,22"/>

                        <Button x:Name="AddModuleButton"
                                Content="Enrol Student in Module"
                                Height="42"
                                Background="#15803D"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AddModule_Click"/>

                        <Separator Margin="0,28,0,22"/>

                        <TextBlock Text="How enrolment works"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="1. Select a student and programme."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Foreground="#526581"/>

                        <TextBlock Text="2. Assign the programme to enrol its modules."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Foreground="#526581"/>

                        <TextBlock Text="3. Add or remove individual modules as needed."
                                   TextWrapping="Wrap"
                                   Foreground="#526581"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>