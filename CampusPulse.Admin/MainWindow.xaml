<Window x:Class="CampusPulse.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Lecturer Dashboard"
        Height="760"
        Width="1200"
        MinHeight="620"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6E3F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#142849">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="22,30,22,35">
                    <TextBlock Text="CampusPulse"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock Text="LECTURER PORTAL"
                               Foreground="#8DA8D1"
                               FontSize="11"
                               Margin="2,8,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="15,0,15,25">
                    <Separator Background="#365174" Margin="8,0,8,16"/>
                    <TextBlock Text="CampusPulse Desktop"
                               Foreground="#8DA8D1"
                               Margin="14,0,0,0"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Overview"
                            Style="{StaticResource NavigationButton}"
                            Click="Overview_Click"/>

                    <Button Content="My Classes"
                            Style="{StaticResource NavigationButton}"
                            Click="Classes_Click"/>

                    <Button Content="Attendance"
                            Style="{StaticResource NavigationButton}"
                            Click="Attendance_Click"/>

                    <Button Content="Announcements"
                            Style="{StaticResource NavigationButton}"
                            Click="Announcements_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="35,28,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock x:Name="PageHeading"
                               Text="Overview"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#172B4D"/>

                    <TextBlock Text="Manage your classes and attendance sessions"
                               FontSize="14"
                               Foreground="#718096"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- OVERVIEW -->
                    <StackPanel x:Name="OverviewPanel">

                        <TextBlock Text="Welcome to CampusPulse"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,20"/>

                        <UniformGrid Columns="3" Margin="0,0,0,25">

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="MY CLASSES"
                                               Foreground="#718096"
                                               FontSize="12"/>
                                    <TextBlock Text="—"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#172B4D"
                                               Margin="0,10,0,0"/>
                                    <TextBlock Text="Awaiting API data"
                                               Foreground="#718096"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE SESSION"
                                               Foreground="#718096"
                                               FontSize="12"/>
                                    <TextBlock Text="—"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#172B4D"
                                               Margin="0,10,0,0"/>
                                    <TextBlock Text="Not connected"
                                               Foreground="#718096"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="ATTENDANCE"
                                               Foreground="#718096"
                                               FontSize="12"/>
                                    <TextBlock Text="—"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#172B4D"
                                               Margin="0,10,0,0"/>
                                    <TextBlock Text="Awaiting API data"
                                               Foreground="#718096"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="White"
                                CornerRadius="12"
                                Padding="25">
                            <StackPanel>
                                <TextBlock Text="Quick Actions"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#172B4D"
                                           Margin="0,0,0,18"/>

                                <Button Content="Manage Attendance"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Click="Attendance_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CLASSES -->
                    <StackPanel x:Name="ClassesPanel"
                                Visibility="Collapsed">
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="28">
                            <StackPanel>
                                <TextBlock Text="My Classes"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#172B4D"/>

                                <TextBlock Text="View your assigned classes and start attendance for a selected session."
                                           TextWrapping="Wrap"
                                           Foreground="#718096"
                                           Margin="0,10,0,18"/>

                                <Button Content="Refresh Classes"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Click="RefreshClasses_Click"/>

                                <TextBlock x:Name="ClassesStatusText"
                                           Text="Open My Classes to load your timetable."
                                           Foreground="#718096"
                                           Margin="0,16,0,14"
                                           TextWrapping="Wrap"/>

                                <DataGrid x:Name="ClassesGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="48"
                                          MinHeight="220"
                                          Margin="0,4,0,0"
                                          SelectionMode="Single">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module"
                                                            Binding="{Binding ModuleCode}"
                                                            Width="95"/>

                                        <DataGridTextColumn Header="Class"
                                                            Binding="{Binding ModuleName}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Day"
                                                            Binding="{Binding DayOfWeek}"
                                                            Width="100"/>

                                        <DataGridTextColumn Header="Time"
                                                            Binding="{Binding TimeDisplay}"
                                                            Width="115"/>

                                        <DataGridTextColumn Header="Venue"
                                                            Binding="{Binding VenueName}"
                                                            Width="115"/>

                                        <DataGridTextColumn Header="Campus"
                                                            Binding="{Binding Campus}"
                                                            Width="110"/>

                                        <DataGridTemplateColumn Header="Attendance"
                                                                Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Start Attendance"
                                                            Background="#2563EB"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="8,7"
                                                            Cursor="Hand"
                                                            Tag="{Binding TimetableId}"
                                                            Click="StartClassAttendance_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ATTENDANCE -->
                    <StackPanel x:Name="AttendancePanel"
                                Visibility="Collapsed">
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="28">
                            <StackPanel>
                                <TextBlock Text="Attendance Management"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#172B4D"/>

                                <TextBlock Text="Start attendance sessions, display live QR codes and manage student check-ins."
                                           TextWrapping="Wrap"
                                           Foreground="#718096"
                                           Margin="0,12,0,22"/>

                                <Button Content="Start Attendance Session"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Click="StartAttendance_Click"/>

                                <TextBlock Text="API integration is the next implementation step."
                                           Foreground="#718096"
                                           Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>