<Window x:Class="CampusPulse.Admin.AdminLecturerAssignmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusPulse | Lecturer Assignments"
        Height="720"
        Width="1100"
        MinHeight="580"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="← Back to Dashboard"
                HorizontalAlignment="Left"
                Width="185"
                Height="36"
                Margin="0,0,0,16"
                Background="#E9EFF8"
                Foreground="#17365D"
                BorderThickness="0"
                Cursor="Hand"
                Click="BackToDashboard_Click"/>

        <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Lecturer Assignments"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#14243B"/>

            <TextBlock
                Text="Assign lecturers to modules and manage existing academic responsibilities."
                FontSize="14"
                Foreground="#617086"
                Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0">
                    <TextBlock Text="LECTURER"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="LecturerComboBox"
                              Height="42"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,16,0">
                    <TextBlock Text="MODULE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="ModuleComboBox"
                              Height="42"
                              DisplayMemberPath="ModuleCode"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="AssignButton"
                        Content="Assign Lecturer"
                        Width="150"
                        Height="42"
                        VerticalAlignment="Bottom"
                        Click="Assign_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="20">

            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current Assignments"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#14243B"/>

                        <TextBlock x:Name="AssignmentCountText"
                                   Text="Loading assignments..."
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Content="Refresh"
                            Width="100"
                            Height="36"
                            Click="Refresh_Click"
                            Background="#E9EFF8"
                            Foreground="#17365D"
                            BorderThickness="0"/>
                </Grid>

                <DataGrid x:Name="AssignmentsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38"
                          AlternatingRowBackground="#F7F9FC">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module"
                                            Binding="{Binding ModuleCode}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Module Name"
                                            Binding="{Binding ModuleName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Lecturer"
                                            Binding="{Binding LecturerName}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Staff Number"
                                            Binding="{Binding StaffNumber}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding AccountStatus}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready."
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,0,20,0"/>

            <Button Grid.Column="1"
                    x:Name="RemoveButton"
                    Content="Remove Selected Assignment"
                    Width="220"
                    Height="42"
                    Click="Remove_Click"
                    Background="#FEE2E2"
                    Foreground="#991B1B"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
        </Grid>
            </Grid>
    </Grid>
</Window>
