<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentDashboardPage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="Dashboard">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- HEADER -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,28,28">

                    <Border.Background>
                        <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Dark=#24204C, Light=#ECEAF5}" Offset="0" />
                            <GradientStop Color="#56336A" Offset="0.55" />
                            <GradientStop Color="#9A4E65" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <VerticalStackLayout
                        Padding="24,35,24,30"
                        Spacing="22">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="5">
                                <Label
                                    Text="CAMPUSPULSE"
                                    FontSize="13"
                                    CharacterSpacing="3"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                                <Label
                                    Text="Welcome back!"
                                    FontSize="27"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                                <Label
                                    Text="Your academic day starts here."
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Dark=#E2D7EE, Light=#44425F}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Dark=#55476E, Light=#D8D4E6}"
                                StrokeThickness="0"
                                Padding="13"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 18">

                                <Image Source="icon_alerts.png" WidthRequest="28" HeightRequest="28" Aspect="AspectFit" />
                            </Border>
                        </Grid>

                        <!-- ATTENDANCE -->
                        <Border
                            BackgroundColor="{AppThemeBinding Dark=#453B70, Light=#D8D4E6}"
                            Stroke="#79618E"
                            StrokeThickness="1"
                            Padding="22"
                            StrokeShape="RoundRectangle 24">

                            <VerticalStackLayout Spacing="15">

                                <Label
                                    Text="OVERALL ATTENDANCE"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CharacterSpacing="2"
                                    TextColor="#E1CDE9" />

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout
                                        VerticalOptions="Center"
                                        Spacing="7">

                                        <Label
                                            Text="--%"
                                            FontSize="46"
                                            FontAttributes="Bold"
                                            TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                                        <Label
                                            Text="Awaiting attendance records"
                                            FontSize="12"
                                            TextColor="#69E5E3" />
                                    </VerticalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        WidthRequest="105"
                                        HeightRequest="105"
                                        BackgroundColor="#625587"
                                        Stroke="#8D7CA8"
                                        StrokeThickness="5"
                                        StrokeShape="RoundRectangle 55">

                                        <Image Source="icon_attendance.png" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- MAIN CONTENT -->
                <VerticalStackLayout
                    Padding="20,28,20,35"
                    Spacing="26">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="QUICK ACTIONS"
                            FontSize="15"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            TextColor="{AppThemeBinding Dark=#D0C9E6, Light=#44425F}" />

                        <Grid
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Dark=#34305E, Light=#ECEAF5}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnScanQrTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_scan.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label Text="Scan QR"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Dark=#34305E, Light=#ECEAF5}"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
    <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTimetableTapped" />
    </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_timetable.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label Text="Timetable"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                BackgroundColor="#234859"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAttendanceTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_attendance.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label Text="Attendance"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="#56314F"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNoticesTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_alerts.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label Text="Notices"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="#59402F"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStudentCardTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_card.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label Text="Student Card"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                BackgroundColor="#234859"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerifyEmailTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Image Source="icon_email.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" Aspect="AspectFit" />
                                    <Label
                                        Text="Verify Email"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- TODAY'S CLASSES -->
                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="TODAY'S CLASSES"
                            FontSize="16"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            TextColor="{AppThemeBinding Dark=#D0C9E6, Light=#44425F}" />

                        <Border
                            BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                            Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                            StrokeThickness="1"
                            Padding="20"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="12">

                                <ActivityIndicator
                                    x:Name="TodayLoadingIndicator"
                                    IsVisible="False"
                                    IsRunning="False"
                                    Color="#FFAD83"
                                    HorizontalOptions="Center" />

                                <Label
                                    x:Name="TodayStatusLabel"
                                    Text="Loading today's classes..."
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />

                                <VerticalStackLayout
                                    x:Name="TodayClassesContainer"
                                    Spacing="14" />

                                <Button
                                    x:Name="TodayRetryButton"
                                    Text="Try Again"
                                    IsVisible="False"
                                    Clicked="OnTodayRetryClicked"
                                    BackgroundColor="#B95632"
                                    TextColor="White"
                                    CornerRadius="12" />

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <!-- NOTIFICATIONS -->
                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="NOTIFICATIONS"
                            FontSize="16"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            TextColor="{AppThemeBinding Dark=#D0C9E6, Light=#44425F}" />

                        <Border
                            BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                            Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                            StrokeThickness="1"
                            Padding="20"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="You're all caught up"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                                <Label
                                    Text="Your campus alerts and reminders will appear here."
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>


    </Grid>
</ContentPage>
