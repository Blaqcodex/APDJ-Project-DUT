<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.MainPage"
    BackgroundColor="#F4F7FB">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="0"
            VerticalOptions="Center">

            <!-- Logo / App Name -->
            <VerticalStackLayout
                Spacing="6"
                Margin="0,0,0,35">

                <Label
                    Text="CampusPulse"
                    FontSize="34"
                    FontAttributes="Bold"
                    TextColor="#172554"
                    HorizontalOptions="Center" />

                <Label
                    Text="Your campus. Your classes. Your attendance."
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Login Card -->
            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="24"
                StrokeShape="RoundRectangle 20">

                <Border.Shadow>
                    <Shadow
                        Brush="#20000000"
                        Offset="0,6"
                        Radius="18"
                        Opacity="0.15" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Welcome back"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#172554" />

                        <Label
                            Text="Sign in to your student account"
                            FontSize="14"
                            TextColor="#64748B" />
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="Student Email"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#334155" />

                        <Border
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,0"
                            StrokeShape="RoundRectangle 12">

                            <Entry
                                Placeholder="Enter your student email"
                                Keyboard="Email"
                                FontSize="15"
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8"
                                BackgroundColor="Transparent" />

                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="Password"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#334155" />

                        <Border
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,0"
                            StrokeShape="RoundRectangle 12">

                            <Entry
                                Placeholder="Enter your password"
                                IsPassword="True"
                                FontSize="15"
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8"
                                BackgroundColor="Transparent" />

                        </Border>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button
                        Text="Sign In"
                        HeightRequest="52"
                        CornerRadius="14"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#6B2FE8"
                        Margin="0,8,0,0" />

                    <!-- Register -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4">

                        <Label
                            Text="Don't have an account?"
                            FontSize="13"
                            TextColor="#64748B"
                            VerticalOptions="Center" />

                        <Button
                            Text="Create one"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#1D4ED8"
                            BackgroundColor="Transparent"
                            Padding="0"
                            HeightRequest="30" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Footer -->
            <Label
                Text="CampusPulse • Student Portal"
                FontSize="12"
                TextColor="#94A3B8"
                HorizontalOptions="Center"
                Margin="0,30,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>