<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentProfilePage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="My Profile">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label Text="STUDENT ACCOUNT"
                       FontSize="13"
                       CharacterSpacing="2"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Label Text="My Profile"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                <Label Text="Your CampusPulse identity and account."
                       FontSize="14"
                       TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                    Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">

                    <Border BackgroundColor="{AppThemeBinding Dark=#55476E, Light=#D8D4E6}"
                            StrokeThickness="0"
                            WidthRequest="90"
                            HeightRequest="90"
                            StrokeShape="RoundRectangle 45"
                            HorizontalOptions="Center">

                        <Label Text="&#x1F464;"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Student Profile"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Your verified student details will appear here."
                           FontSize="13"
                           TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Label Text="ACCOUNT"
                   FontSize="14"
                   CharacterSpacing="1"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=#D0C9E6, Light=#44425F}" />

            <Border BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                    Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="20">

                    <Label Text="&#x1F4B3;   Digital Student Card"
                           FontSize="16"
                           TextColor="{AppThemeBinding Dark=White, Light=#202038}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStudentCardTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}" />

                    <Label Text="&#x2699;   Settings"
                           FontSize="16"
                           TextColor="{AppThemeBinding Dark=White, Light=#202038}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}" />

                    <Label Text="&#x2753;   Help &amp; Support"
                           FontSize="16"
                           TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                </VerticalStackLayout>
            </Border>
            <Button
                Text="Log Out"
                Clicked="OnLogoutClicked"
                BackgroundColor="#3B263D"
                TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="56"
                CornerRadius="16"
                BorderColor="#70445A"
                BorderWidth="1" />






















</VerticalStackLayout>
    </ScrollView>
</ContentPage>
