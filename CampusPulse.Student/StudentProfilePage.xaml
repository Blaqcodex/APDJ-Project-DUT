<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentProfilePage"
    BackgroundColor="#101027"
    Title="My Profile">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label Text="STUDENT ACCOUNT"
                       FontSize="13"
                       CharacterSpacing="2"
                       FontAttributes="Bold"
                       TextColor="#FFAD83" />

                <Label Text="My Profile"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label Text="Your CampusPulse identity and account."
                       FontSize="14"
                       TextColor="#B5B4D0" />
            </VerticalStackLayout>

            <Border BackgroundColor="#242342"
                    Stroke="#38365C"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">

                    <Border BackgroundColor="#55476E"
                            StrokeThickness="0"
                            WidthRequest="90"
                            HeightRequest="90"
                            StrokeShape="RoundRectangle 45"
                            HorizontalOptions="Center">

                        <Label Text="&#x1F464;"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Student Profile"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Your verified student details will appear here."
                           FontSize="13"
                           TextColor="#B5B4D0"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Label Text="ACCOUNT"
                   FontSize="14"
                   CharacterSpacing="1"
                   FontAttributes="Bold"
                   TextColor="#D0C9E6" />

            <Border BackgroundColor="#242342"
                    Stroke="#38365C"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="20">

                    <Label Text="&#x1F4B3;   Digital Student Card"
                           FontSize="16"
                           TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStudentCardTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1"
                             Color="#38365C" />

                    <Label Text="&#x2699;   Settings"
                           FontSize="16"
                           TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1"
                             Color="#38365C" />

                    <Label Text="&#x2753;   Help &amp; Support"
                           FontSize="16"
                           TextColor="White" />

                </VerticalStackLayout>
            </Border>
            <Button
                Text="Log Out"
                Clicked="OnLogoutClicked"
                BackgroundColor="#3B263D"
                TextColor="#FFAD83"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="56"
                CornerRadius="16"
                BorderColor="#70445A"
                BorderWidth="1" />






















</VerticalStackLayout>
    </ScrollView>
</ContentPage>
