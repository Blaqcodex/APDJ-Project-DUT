<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.ResetPasswordPage"
    Title="Reset Password"
    BackgroundColor="#101027">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,50"
            Spacing="22">

            <Label
                Text="CAMPUSPULSE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#69E5E3"
                HorizontalOptions="Center" />

            <Label
                Text="Create a new password"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Enter the six-digit code sent to your verified recovery email and choose a new password."
                FontSize="14"
                TextColor="#B8B8D0"
                HorizontalTextAlignment="Center" />

            <Border
                BackgroundColor="#1D1D3B"
                Stroke="#34345F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Six-Digit Reset Code"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="ResetCodeEntry"
                        Placeholder="Enter 6-digit code"
                        Keyboard="Numeric"
                        MaxLength="6"
                        TextColor="White"
                        PlaceholderColor="#B8B8D0" />

                    <Label
                        Text="New Password"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="NewPasswordEntry"
                        Placeholder="Minimum 8 characters"
                        IsPassword="True"
                        MaxLength="100"
                        TextColor="White"
                        PlaceholderColor="#B8B8D0" />

                    <Label
                        Text="Confirm New Password"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="ConfirmPasswordEntry"
                        Placeholder="Re-enter new password"
                        IsPassword="True"
                        MaxLength="100"
                        TextColor="White"
                        PlaceholderColor="#B8B8D0" />

                    <Button
                        x:Name="ResetPasswordButton"
                        Text="Reset Password"
                        BackgroundColor="#FF756B"
                        TextColor="#101027"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="52"
                        Clicked="OnResetPasswordClicked" />

                    <Label
                        x:Name="StatusLabel"
                        FontSize="13"
                        TextColor="#69E5E3"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Back to Sign In"
                BackgroundColor="Transparent"
                TextColor="#69E5E3"
                Clicked="OnBackToLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>