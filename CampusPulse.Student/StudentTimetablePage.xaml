<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentTimetablePage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="My Timetable">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="MY TIMETABLE"
                    FontSize="13"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Label
                    Text="Your weekly classes"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                <Label
                    Text="Stay on top of your lectures and venues."
                    FontSize="14"
                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                StrokeThickness="1"
                Padding="24"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="📅"
                        FontSize="42"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No classes scheduled yet"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your registered modules and weekly timetable will appear here once your classes are available."
                        FontSize="13"
                        TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
