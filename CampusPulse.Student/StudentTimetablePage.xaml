<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentTimetablePage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="My Timetable">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="MY TIMETABLE"
                    FontSize="13"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Label
                    Text="Your weekly classes"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                <Label
                    Text="Stay on top of your lectures and venues."
                    FontSize="14"
                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
            </VerticalStackLayout>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#FFAD83"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                IsVisible="False"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />

            <Button
                x:Name="RetryButton"
                Text="Try Again"
                IsVisible="False"
                Clicked="OnRetryClicked"
                BackgroundColor="#B95632"
                TextColor="White"
                CornerRadius="12" />

            <VerticalStackLayout
                x:Name="TimetableContainer"
                Spacing="20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>