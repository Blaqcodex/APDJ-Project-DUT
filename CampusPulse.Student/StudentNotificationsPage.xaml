<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentNotificationsPage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="Notifications">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="CAMPUS UPDATES"
                    FontSize="13"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Label
                    Text="Notifications"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                <Label
                    Text="Important announcements, class reminders and attendance updates."
                    FontSize="14"
                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                StrokeThickness="1"
                Padding="24"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="&#x1F514;"
                        FontSize="42"
                        HorizontalOptions="Center" />

                    <Label
                        Text="You're all caught up"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your university announcements, class reminders and important alerts will appear here when available."
                        FontSize="14"
                        TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
