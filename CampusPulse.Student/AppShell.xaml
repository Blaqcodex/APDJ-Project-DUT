<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusPulse.Student.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CampusPulse.Student"
    Title="CampusPulse"
    Shell.BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Shell.ForegroundColor="{AppThemeBinding Dark=White, Light=#202038}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Dark=#1B1936, Light=#FFFFFF}"
    Shell.TabBarForegroundColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}">

    <!-- Authentication entry -->
    <ShellContent
        Title="Login"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}"
        Shell.NavBarIsVisible="False" />

    <!-- Student navigation -->
    <TabBar
        Route="StudentTabs"
        FlyoutItemIsVisible="False"
        Shell.BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
        Shell.ForegroundColor="{AppThemeBinding Dark=#FFFFFF, Light=#202038}"
        Shell.TitleColor="{AppThemeBinding Dark=#FFFFFF, Light=#202038}"
        Shell.DisabledColor="{AppThemeBinding Dark=#77738F, Light=#A5A3B8}"
        Shell.TabBarBackgroundColor="{AppThemeBinding Dark=#1B1936, Light=#FFFFFF}"
        Shell.TabBarForegroundColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}"
        Shell.TabBarTitleColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}"
        Shell.TabBarUnselectedColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}">
        <ShellContent Icon="icon_home.png"
            Title="Home"
            Route="StudentHome"
            ContentTemplate="{DataTemplate local:StudentDashboardPage}" />

        <ShellContent Icon="icon_timetable.png"
            Title="Timetable"
            Route="StudentSchedule"
            ContentTemplate="{DataTemplate local:StudentTimetablePage}" />

        <ShellContent Icon="icon_scan.png"
            Title="Scan QR"
            Route="StudentScan"
            ContentTemplate="{DataTemplate local:StudentQrScannerPage}" />

        <ShellContent Icon="icon_alerts.png"
            Title="Alerts"
            Route="StudentAlerts"
            ContentTemplate="{DataTemplate local:StudentNotificationsPage}" />

        <ShellContent Icon="icon_profile.png"
            Title="Profile"
            Route="StudentProfile"
            ContentTemplate="{DataTemplate local:StudentProfilePage}" />
    </TabBar>

</Shell>

