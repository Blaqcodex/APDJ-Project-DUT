<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.ForgotPasswordPage"
    Title="Forgot Password"
    BackgroundColor="#101027">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,50"
            Spacing="22">

            <Label
                Text="CAMPUSPULSE"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#69E5E3"
                HorizontalOptions="Center" />

            <Label
                Text="Forgot your password?"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Enter your registered DUT student email address. We'll send password reset instructions to your verified personal recovery Gmail."
                FontSize="14"
                TextColor="#B8B8D0"
                HorizontalTextAlignment="Center" />

            <Border
                BackgroundColor="#1D1D3B"
                Stroke="#34345F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Recovery Email"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Border
                        BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,2">

                        <Entry
                            x:Name="RecoveryEmailEntry"
                            Placeholder="Enter your recovery email"
                            Keyboard="Email"
                            TextColor="#241A49"
                            PlaceholderColor="#A49AB8"
                            BackgroundColor="Transparent" />

                    </Border>

                    <Button
                        x:Name="SendResetButton"
                        Text="Send Reset Instructions"
                        BackgroundColor="#FF756B"
                        TextColor="#101027"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="52"
                        Clicked="OnSendResetClicked" />

                    <Label
                        x:Name="StatusLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#69E5E3"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Back to Sign In"
                BackgroundColor="Transparent"
                TextColor="#69E5E3"
                FontSize="14"
                Clicked="OnBackToLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
