<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentCardPage"
    BackgroundColor="#101027"
    Title="Digital Student Card">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="22">

            <Label Text="DIGITAL IDENTITY"
                   FontSize="12"
                   CharacterSpacing="2"
                   FontAttributes="Bold"
                   TextColor="#FFAD83" />

            <Label Text="My Student Card"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Label Text="Your CampusPulse student identity."
                   FontSize="14"
                   TextColor="#B5B4D0" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                Color="#FFAD83"
                IsRunning="True"
                IsVisible="True" />

            <Label x:Name="StatusLabel"
                   Text="Loading your student details..."
                   FontSize="14"
                   TextColor="#B5B4D0" />

            <Border x:Name="StudentCard"
                    IsVisible="False"
                    BackgroundColor="#242342"
                    Stroke="#FFAD83"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="14">

                    <!-- Card branding -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="CAMPUSPULSE"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#FFAD83" />

                            <Label Text="DIGITAL STUDENT ID"
                                   FontSize="9"
                                   CharacterSpacing="1"
                                   TextColor="#D0C9E6" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="STUDENT"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#594A65" />

                    <!-- Student details and photo -->
                    <Grid ColumnDefinitions="*,100"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Center">

                            <Label x:Name="StudentNumberLabel"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#FFAD83" />

                            <Label x:Name="StudentNameLabel"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="ProgrammeLabel"
                                   FontSize="12"
                                   TextColor="#D0C9E6"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="FacultyLabel"
                                   FontSize="11"
                                   TextColor="#B5B4D0"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="YearLevelLabel"
                                   FontSize="11"
                                   TextColor="#B5B4D0" />

                        </VerticalStackLayout>

                        <!-- Photo placeholder -->
                        <Border Grid.Column="1"
                                BackgroundColor="#55476E"
                                Stroke="#FFAD83"
                                StrokeThickness="1"
                                HeightRequest="125"
                                StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="6">

                                <Label Text="&#x1F464;"
                                       FontSize="38"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="PHOTO"
                                       FontSize="10"
                                       TextColor="#D0C9E6"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Decorative barcode -->
                    <Border BackgroundColor="#E9E5F0"
                            StrokeThickness="0"
                            Padding="12"
                            StrokeShape="RoundRectangle 8">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="|||| ||| |||||| || ||||| |||| |||"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#101027"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap" />

                            <Label Text="CARD PREVIEW - NOT SCANNABLE"
                                   FontSize="9"
                                   TextColor="#101027"
                                   HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="InstitutionLabel"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#FFAD83"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="EmailLabel"
                           FontSize="11"
                           TextColor="#B5B4D0"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

            <Label Text="CampusPulse student card preview. This is not an official DUT identification document."
                   FontSize="12"
                   TextColor="#B5B4D0"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
