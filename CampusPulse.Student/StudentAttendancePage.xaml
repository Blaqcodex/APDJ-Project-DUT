<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CampusPulse.Student.StudentAttendancePage"
    BackgroundColor="{AppThemeBinding Dark=#101027, Light=#F7F7FC}"
    Title="My Attendance">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="MY ATTENDANCE"
                    FontSize="13"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Label
                    Text="Track your progress"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                <Label
                    Text="View your class attendance and stay on track."
                    FontSize="14"
                    TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="{AppThemeBinding Dark=#453B70, Light=#D8D4E6}"
                StrokeThickness="0"
                Padding="24"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="OVERALL ATTENDANCE"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="{AppThemeBinding Dark=#D6D0F4, Light=#44425F}" />

                    <Label
                        Text="--%"
                        FontSize="48"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Dark=White, Light=#202038}" />

                    <Label
                        Text="Awaiting attendance records"
                        FontSize="13"
                        TextColor="{AppThemeBinding Dark=#D6D0F4, Light=#44425F}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Label
                    Text="ATTENDANCE BY MODULE"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Border
                    BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                    Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="No module attendance yet"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Your attendance percentages for each registered module will appear here."
                            FontSize="13"
                            TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Label
                    Text="ATTENDANCE HISTORY"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="{AppThemeBinding Dark=#FFAD83, Light=#B95632}" />

                <Border
                    BackgroundColor="{AppThemeBinding Dark=#242342, Light=#FFFFFF}"
                    Stroke="{AppThemeBinding Dark=#38365C, Light=#E4E3F0}"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="No attendance history available"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Dark=White, Light=#202038}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Your recorded class attendance will appear here once attendance tracking is active."
                            FontSize="13"
                            TextColor="{AppThemeBinding Dark=#B5B4D0, Light=#686680}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
